
<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <Nullable>enable</Nullable>
        <UseWindowsForms>true</UseWindowsForms>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Dapper" Version="2.1.89" />
        <PackageReference Include="Microsoft.Data.Sqlite" Version="11.0.0" />
        <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="11.0.0" />
        <PackageReference Include="QRCoder" Version="1.8.1" />
    </ItemGroup>

    <!-- Thư mục tài nguyên hình ảnh -->
    <ItemGroup>
        <Folder Include="Resources\Icons\" />
        <Folder Include="Resources\Images\Banners\" />
        <Folder Include="Resources\Images\Promotions\" />
    </ItemGroup>

    <!-- Tự động sao chép hình ảnh sang thư mục chạy ứng dụng -->
    <ItemGroup>
        <Content Include="Resources\**\*">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <Compile Update="Forms\LoginForm.cs">
            <SubType>Form</SubType>
        </Compile>
        <Compile Update="UserControls\Common\SeatMatrixUC.cs">
            <SubType>UserControl</SubType>
        </Compile>
        <Compile Update="UserControls\Common\MovieCardUC.cs">
            <SubType>UserControl</SubType>
        </Compile>
        <Compile Update="UserControls\Staff\POSUC.cs">
            <SubType>UserControl</SubType>
        </Compile>
        <Compile Update="UserControls\Staff\TicketScannerUC.cs">
            <SubType>UserControl</SubType>
        </Compile>
        <Compile Update="Forms\Dialogs\ConfirmBookingDialog.cs">
            <SubType>Form</SubType>
        </Compile>
        <Compile Update="Forms\Dialogs\MovieEditDialog.cs">
            <SubType>Form</SubType>
        </Compile>
    </ItemGroup>

</Project>
